{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "esp32s3",
      "displayName": "ESP32-S3 (ESP-IDF 6.0.2)",
      "description": "Mirrors idf.py and keeps the ESP-IDF 6 build separate from earlier SDK caches.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/idf6",
      "cacheVariables": {
        "IDF_TARGET": "esp32s3",
        "CCACHE_ENABLE": "1",
        "CMAKE_TOOLCHAIN_FILE": "$env{IDF_PATH}/tools/cmake/toolchain-esp32s3.cmake"
      }
    }
  ]
}
