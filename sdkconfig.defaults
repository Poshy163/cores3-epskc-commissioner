CONFIG_IDF_TARGET="esp32s3"
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=n

# CoreS3: 16 MB flash, native USB-Serial-JTAG console.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# PSRAM on this board is QUAD, not octal. Declaring it octal panics at boot with
# "PSRAM chip is not connected, or wrong PSRAM line mode". Probed and confirmed:
# 8 MB found, memory test OK, ~8.38 MB usable.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Push Wi-Fi/lwIP buffers into PSRAM. Without this they compete with the
# OpenThread stack for internal RAM and UDP sends start failing with
# MBEDTLS_ERR_NET_SEND_FAILED (-0x004E) long before any crypto runs.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# This appliance carries only control-plane HTTP, mDNS and Thread backbone
# traffic; it does not need the iperf-oriented 16+16 permanent Wi-Fi buffer
# profile selected when PSRAM is present. Eight RX/TX buffers still match the
# AMPDU receive window while returning roughly 25 KB of DMA-capable SRAM to the
# camera and other hardware drivers.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=8
# Keep 64 KB (default 32) of internal RAM out of reach of ordinary malloc():
# once free internal drops below this, small allocations go to PSRAM instead.
# DMA buffers and latency-sensitive stacks still need internal RAM; with LVGL,
# mbedTLS and OpenThread competing, the default left the camera staging block
# and border-router work with no contiguous space to allocate.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Matter commissioning uses NimBLE.  Keep the controller, Matter allocations,
# TLS allocations and large static tables in PSRAM because the camera and H2
# radio paths both need scarce internal/DMA-capable SRAM.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Camera + quirc + LVGL + mbedTLS outgrew the 1.5 MB default app partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# EC-JPAKE is the whole point: off by default, and DTLS needs turning on too.
CONFIG_MBEDTLS_ECJPAKE_C=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_CCM_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y

# Roomier stacks/buffers than the defaults; DTLS handshakes are stack-hungry.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=7200
CONFIG_ESP_TIMER_TASK_STACK_SIZE=5120
CONFIG_THREAD_TASK_STACK_SIZE=8192
CONFIG_CHIP_TASK_STACK_SIZE=10240
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

CONFIG_LWIP_IPV6=y

# OpenThread host stack driving the on-board ESP32-H2 over spinel/UART, so the
# device can actually attach to the network whose credentials it retrieved.
# MTD rather than FTD: it only needs to join as a child, and FTD costs more RAM
# than this board has spare.
CONFIG_OPENTHREAD_ENABLED=y
# FTD, not MTD: the spinel/RCP callbacks IDF's radio port calls
# (SetCompatibilityErrorCallback, SetCoprocessorResetFailureCallback) are only
# declared under the FTD/spinel config headers, so MTD fails to compile against
# a radio co-processor. A host driving an RCP is a full Thread device anyway.
CONFIG_OPENTHREAD_FTD=y
CONFIG_OPENTHREAD_RADIO_SPINEL_UART=y
# 1024 buffers is a 128 KB pool -- far more than a joining end device needs,
# and this board has no internal RAM to spare for it.
CONFIG_OPENTHREAD_NUM_MESSAGE_BUFFERS=128
CONFIG_OPENTHREAD_CLI=n
CONFIG_OPENTHREAD_DIAG=n
# Quieten the stack: at INFO it logs every MLE advertisement on the mesh, which
# buries everything else in the serial output.
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_NOTE=y
# A border router provides SRP/DNS-SD server and proxy services; it does not
# need the end-device SRP and DNS client roles linked into the host stack.
CONFIG_OPENTHREAD_SRP_CLIENT=n
CONFIG_OPENTHREAD_DNS_CLIENT=n
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_VFS_SUPPORT_SELECT=y

# Border Router. This is what publishes _meshcop._udp over Wi-Fi and makes the
# device appear alongside the other border routers in Home Assistant, rather
# than joining as an invisible child. Settings mirror M5Stack's own BR config.
CONFIG_OPENTHREAD_BORDER_ROUTER=y
CONFIG_MDNS_MULTIPLE_INSTANCE=y
# Thread service proxying plus Matter advertisements can easily exceed the
# component defaults of 10 services and a 16-entry work queue.
CONFIG_MDNS_MAX_SERVICES=200
CONFIG_MDNS_ACTION_QUEUE_LEN=64
CONFIG_LWIP_IPV6_FORWARD=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=12
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_LWIP_NETIF_STATUS_CALLBACK=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_HOOK_IP6_INPUT_CUSTOM=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_HOOK_IP6_SELECT_SRC_ADDR_CUSTOM=y
CONFIG_LWIP_FORCE_ROUTER_FORWARDING=y
# Heavy work is deferred off `sys_evt` to its own task rather than relying on
# this figure -- an event handler is the wrong place for stack-hungry init.

# Matter 1.5.1 Thread Border Router device type (0x0091).  Use the shared IDF
# mDNS responder and ESP-IDF border-router route hook, not duplicate CHIP
# implementations.  The existing app remains the Wi-Fi connection owner.
CONFIG_THREAD_NETWORK_COMMISSIONING_DRIVER=n
CONFIG_USE_MINIMAL_MDNS=n
CONFIG_ENABLE_ROUTE_HOOK=n
CONFIG_ENABLE_CHIP_SHELL=n
CONFIG_ENABLE_OTA_REQUESTOR=n
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=3
# Advertise the Thread Border Router device type (0x0091 = 145) in the
# commissionable-node record, so a commissioner can label the device before
# it pairs. Vendor, product and hardware strings come from the provider in
# matter.cpp; the VID/PID stay in the CSA test range.
CONFIG_ENABLE_COMMISSIONABLE_DEVICE_TYPE=y
CONFIG_DEVICE_TYPE=145
# Compile CHIP's runtime category filter in. The ESP32 port prints the
# "I (t) chip[XX]:" prefix with a bare printf before the message reaches
# esp_log, so the per-tag ESP log level alone cannot silence it; the console's
# `log` command drives this filter instead.
CONFIG_CHIP_LOG_FILTERING=y
CONFIG_ESP_MATTER_NVS_PART_NAME="matter_nvs"
CONFIG_CHIP_FACTORY_NAMESPACE_PARTITION_LABEL="matter_nvs"
CONFIG_CHIP_CONFIG_NAMESPACE_PARTITION_LABEL="matter_nvs"
CONFIG_CHIP_COUNTERS_NAMESPACE_PARTITION_LABEL="matter_nvs"
CONFIG_CHIP_KVS_NAMESPACE_PARTITION_LABEL="matter_nvs"

# Compile only the cluster servers instantiated by the Root Node and Thread
# Border Router (0x0091) endpoints.  ESP-Matter otherwise defaults every
# generated cluster to enabled, which adds several minutes to clean builds and
# pulls in unrelated Matter 1.5 application clusters.
CONFIG_SUPPORT_ACCESS_CONTROL_CLUSTER=y
CONFIG_SUPPORT_ADMINISTRATOR_COMMISSIONING_CLUSTER=y
CONFIG_SUPPORT_BASIC_INFORMATION_CLUSTER=y
CONFIG_SUPPORT_BINDING_CLUSTER=y
CONFIG_SUPPORT_DESCRIPTOR_CLUSTER=y
CONFIG_SUPPORT_GENERAL_COMMISSIONING_CLUSTER=y
CONFIG_SUPPORT_GENERAL_DIAGNOSTICS_CLUSTER=y
CONFIG_SUPPORT_GROUP_KEY_MANAGEMENT_CLUSTER=y
CONFIG_SUPPORT_IDENTIFY_CLUSTER=y
CONFIG_SUPPORT_NETWORK_COMMISSIONING_CLUSTER=y
CONFIG_SUPPORT_OPERATIONAL_CREDENTIALS_CLUSTER=y
CONFIG_SUPPORT_THREAD_BORDER_ROUTER_MANAGEMENT_CLUSTER=y
CONFIG_SUPPORT_THREAD_NETWORK_DIAGNOSTICS_CLUSTER=y
CONFIG_SUPPORT_WIFI_NETWORK_DIAGNOSTICS_CLUSTER=y
CONFIG_SUPPORT_ACCOUNT_LOGIN_CLUSTER=n
CONFIG_SUPPORT_ACTIONS_CLUSTER=n
CONFIG_SUPPORT_ACTIVATED_CARBON_FILTER_MONITORING_CLUSTER=n
CONFIG_SUPPORT_AIR_QUALITY_CLUSTER=n
CONFIG_SUPPORT_APPLICATION_BASIC_CLUSTER=n
CONFIG_SUPPORT_APPLICATION_LAUNCHER_CLUSTER=n
CONFIG_SUPPORT_AUDIO_OUTPUT_CLUSTER=n
CONFIG_SUPPORT_BOOLEAN_STATE_CLUSTER=n
CONFIG_SUPPORT_BOOLEAN_STATE_CONFIGURATION_CLUSTER=n
CONFIG_SUPPORT_BRIDGED_DEVICE_BASIC_INFORMATION_CLUSTER=n
CONFIG_SUPPORT_CAMERA_AV_SETTINGS_USER_LEVEL_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_CAMERA_AV_STREAM_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_CARBON_DIOXIDE_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_CARBON_MONOXIDE_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_CHANNEL_CLUSTER=n
CONFIG_SUPPORT_CHIME_CLUSTER=n
CONFIG_SUPPORT_CLOSURE_CONTROL_CLUSTER=n
CONFIG_SUPPORT_CLOSURE_DIMENSION_CLUSTER=n
CONFIG_SUPPORT_COLOR_CONTROL_CLUSTER=n
CONFIG_SUPPORT_COMMISSIONER_CONTROL_CLUSTER=n
CONFIG_SUPPORT_COMMODITY_METERING_CLUSTER=n
CONFIG_SUPPORT_COMMODITY_PRICE_CLUSTER=n
CONFIG_SUPPORT_COMMODITY_TARIFF_CLUSTER=n
CONFIG_SUPPORT_CONTENT_LAUNCHER_CLUSTER=n
CONFIG_SUPPORT_CONTENT_CONTROL_CLUSTER=n
CONFIG_SUPPORT_CONTENT_APP_OBSERVER_CLUSTER=n
CONFIG_SUPPORT_DEVICE_ENERGY_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_DEVICE_ENERGY_MANAGEMENT_MODE_CLUSTER=n
CONFIG_SUPPORT_DIAGNOSTIC_LOGS_CLUSTER=n
CONFIG_SUPPORT_DISHWASHER_ALARM_CLUSTER=n
CONFIG_SUPPORT_DISHWASHER_MODE_CLUSTER=n
CONFIG_SUPPORT_ELECTRICAL_GRID_CONDITIONS_CLUSTER=n
CONFIG_SUPPORT_GROUPCAST_CLUSTER=n
CONFIG_SUPPORT_METER_IDENTIFICATION_CLUSTER=n
CONFIG_SUPPORT_MICROWAVE_OVEN_MODE_CLUSTER=n
CONFIG_SUPPORT_DOOR_LOCK_CLUSTER=n
CONFIG_SUPPORT_ECOSYSTEM_INFORMATION_CLUSTER=n
CONFIG_SUPPORT_ELECTRICAL_ENERGY_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_ELECTRICAL_POWER_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_ENERGY_EVSE_CLUSTER=n
CONFIG_SUPPORT_ENERGY_EVSE_MODE_CLUSTER=n
CONFIG_SUPPORT_ETHERNET_NETWORK_DIAGNOSTICS_CLUSTER=n
CONFIG_SUPPORT_ENERGY_PREFERENCE_CLUSTER=n
CONFIG_SUPPORT_FAN_CONTROL_CLUSTER=n
CONFIG_SUPPORT_FAULT_INJECTION_CLUSTER=n
CONFIG_SUPPORT_FIXED_LABEL_CLUSTER=n
CONFIG_SUPPORT_FORMALDEHYDE_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_GROUPS_CLUSTER=n
CONFIG_SUPPORT_HEPA_FILTER_MONITORING_CLUSTER=n
CONFIG_SUPPORT_ICD_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_JOINT_FABRIC_DATASTORE_CLUSTER=n
CONFIG_SUPPORT_JOINT_FABRIC_ADMINISTRATOR_CLUSTER=n
CONFIG_SUPPORT_KEYPAD_INPUT_CLUSTER=n
CONFIG_SUPPORT_LAUNDRY_WASHER_MODE_CLUSTER=n
CONFIG_SUPPORT_LEVEL_CONTROL_CLUSTER=n
CONFIG_SUPPORT_LOCALIZATION_CONFIGURATION_CLUSTER=n
CONFIG_SUPPORT_LOW_POWER_CLUSTER=n
CONFIG_SUPPORT_MEDIA_INPUT_CLUSTER=n
CONFIG_SUPPORT_MEDIA_PLAYBACK_CLUSTER=n
CONFIG_SUPPORT_MICROWAVE_OVEN_CONTROL_CLUSTER=n
CONFIG_SUPPORT_MESSAGES_CLUSTER=n
