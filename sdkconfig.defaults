CONFIG_SUPPORT_WATER_HEATER_MODE_CLUSTER=n
CONFIG_SUPPORT_ZONE_MANAGEMENT_CLUSTER=n

# LVGL fonts used by the status screen.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y

# Camera. CONFIG_CAMERA_GC0308 defaults to 'n', so without this the DVP
# interface comes up with no sensor behind it and /dev/video0 never appears --
# which is what "Camera unavailable" was.
# Grayscale 320x240 is chosen deliberately: quirc wants 8-bit luma, so this
# avoids a colour conversion per frame entirely.
# The DVP controller wants a single contiguous DMA buffer, and DMA can only come
# from internal RAM. The 32 KB default never fits next to the Thread stack, and
# 8192 is the Kconfig minimum (range 8192 32768 -- a smaller value is silently
# replaced by the 32 KB default, which then fails every time). For 320x240 GREY
# the driver derives a 7680-byte staging buffer and recreates it on every
# STREAMON. The reduced Wi-Fi RX/TX footprint above leaves that contiguous
# internal block available while cache-sensitive task stacks remain internal.
CONFIG_CAM_CTRL_DVP_DMA_BUFFER_SIZE=8192

CONFIG_CAMERA_GC0308=y
CONFIG_CAMERA_GC0308_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_GC0308_DVP_GRAY_320X240_20FPS=y
CONFIG_CAMERA_GC0308_DVP_DEFAULT_FMT_GRAY_320X240_20FPS=y
CONFIG_LV_FONT_MONTSERRAT_16=y

# QR widget for showing the dataset TLVs on screen.
CONFIG_LV_USE_QRCODE=y

# The 64 KB built-in LVGL heap was always marginal: 40 KB boot-looped with a
# white screen, and 64 KB eventually ran out too (see below). Sizing it is the
# wrong game, so the allocator itself changed rather than the number.

# LVGL's built-in allocator is a fixed 64 KB array in internal .bss
# (work_mem_int). Seventeen pre-built panels plus a draw-task descriptor for
# every label drawn in every refresh slice exhaust it, and LV_ASSERT_MALLOC's
# default handler is "while(1);" -- so the LVGL task spins forever, starves
# IDLE0, and the whole UI freezes with the task watchdog firing every 5 s.
# The C library allocator has no fixed ceiling and hands the 64 KB back to the
# internal heap that camera DMA and the Thread stack compete for; with
# SPIRAM_USE_MALLOC it only spills to PSRAM once internal RAM is truly scarce.
CONFIG_LV_USE_CLIB_MALLOC=y

# That assert logs before halting, but LVGL logging was off, so the failure was
# silent and looked like a hang with no cause. Warnings and errors only.
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
